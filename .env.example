PORT=3000
NODE_ENV=development

# Server-only runtime configuration. Keep Firebase Admin service-account credentials out of this file.
FIREBASE_PROJECT_ID=
GOOGLE_APPS_SCRIPT_URL=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Firebase Admin credential fields. Never commit real values or service-account JSON.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Public browser configuration. These VITE_ values are embedded in the frontend bundle.
VITE_GOOGLE_SHEET_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_RECAPTCHA_SITE_KEY=
